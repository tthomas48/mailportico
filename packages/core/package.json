{
  "name": "@textportico/core",
  "version": "0.0.2",
  "description": "Text Portico core — HTTP dev server, file-backed messages, notify POST",
  "homepage": "https://github.com/tthomas48/textportico#readme",
  "bugs": {
    "url": "https://github.com/tthomas48/textportico/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tthomas48/textportico.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ./scripts/copy-web.mjs",
    "dev": "NODE_ENV=development tsx watch src/cli-dev.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/ws": "^8.18.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
